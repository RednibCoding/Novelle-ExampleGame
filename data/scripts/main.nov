# Main script - Global settings and entry point
# DERELICT: A Short Escape

include chapter1 chapter2 endings

label _setup
    # Global settings
    typing key.ogg

    # Character aliases
    alias ??? Unknown Voice
    alias AI ARIA-7
    alias Protagonist You

    background title_bg
    music title_theme.ogg
    wait

label _start
    # Start the game
    background
    showoverlay ARIA
    wait 2.0
    goto intro
